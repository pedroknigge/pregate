{
  "id": "sample/gaps/no-alert",
  "version": "1.0.0",
  "area": "gaps",
  "cardinality": "singleton",
  "dimension": "sample.alert",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "alert-call",
          "rule": { "kind": "call_expression", "has": { "field": "function", "regex": "^alert$" } }
        }
      ]
    }
  },
  "phase": ["pre", "stop", "commit", "ci"],
  "feedback": { "message": "{symbol} calls alert." }
}
