{
  "note": "Routine commands an agent runs while it develops a project. Hand-assembled; it is not a usage sample. `intent` says what the command does to the project: `read` changes nothing, `outside` writes only outside the governed sources, `source` writes a governed source file from the shell, `contract` changes the contract or the protection.",
  "commands": [
    { "id": "git-status", "group": "git", "intent": "read", "command": "git status --short" },
    { "id": "git-diff", "group": "git", "intent": "read", "command": "git diff --stat HEAD" },
    { "id": "git-log", "group": "git", "intent": "read", "command": "git log --oneline -5" },
    { "id": "git-show", "group": "git", "intent": "read", "command": "git show HEAD:src/a.ts" },
    { "id": "git-blame", "group": "git", "intent": "read", "command": "git blame -L 1,2 src/a.ts" },
    { "id": "git-grep", "group": "git", "intent": "read", "command": "git grep -n total -- src" },
    { "id": "git-branch-list", "group": "git", "intent": "read", "command": "git branch -a" },
    { "id": "git-add", "group": "git", "intent": "outside", "command": "git add -A" },
    { "id": "git-add-file", "group": "git", "intent": "outside", "command": "git add src/a.ts" },
    { "id": "git-commit", "group": "git", "intent": "outside", "command": "git commit -m 'Add the total'" },
    { "id": "git-commit-heredoc", "group": "git", "intent": "outside", "command": "git commit -m \"$(cat <<'EOF'\nAdd the total\n\nIt sums the lines.\nEOF\n)\"" },
    { "id": "git-push", "group": "git", "intent": "outside", "command": "git push -u origin feature" },
    { "id": "git-fetch", "group": "git", "intent": "outside", "command": "git fetch origin" },
    { "id": "git-new-branch", "group": "git", "intent": "outside", "command": "git checkout -b feature" },
    { "id": "git-switch-create", "group": "git", "intent": "outside", "command": "git switch -c feature" },
    { "id": "git-checkout-branch", "group": "git", "intent": "source", "command": "git checkout other" },
    { "id": "git-restore-file", "group": "git", "intent": "source", "command": "git checkout -- src/a.ts" },
    { "id": "git-stash", "group": "git", "intent": "source", "command": "git stash" },
    { "id": "git-reset-soft", "group": "git", "intent": "outside", "command": "git reset --soft HEAD~1" },
    { "id": "git-reset-hard", "group": "git", "intent": "source", "command": "git reset --hard HEAD~1" },
    { "id": "git-merge", "group": "git", "intent": "source", "command": "git merge other" },
    { "id": "git-rebase", "group": "git", "intent": "source", "command": "git rebase other" },
    { "id": "git-pull", "group": "git", "intent": "source", "command": "git pull --ff-only" },
    { "id": "git-tag-list", "group": "git", "intent": "read", "command": "git tag --list" },
    { "id": "git-commit-no-verify", "group": "git", "intent": "contract", "command": "git commit --no-verify -m skip" },
    { "id": "gh-pr-view", "group": "git", "intent": "read", "command": "gh pr view 12 --json state" },
    { "id": "gh-pr-create", "group": "git", "intent": "outside", "command": "gh pr create --title 'Add the total' --body 'It sums the lines.'" },
    { "id": "npm-install", "group": "npm", "intent": "outside", "command": "npm install" },
    { "id": "npm-ci", "group": "npm", "intent": "outside", "command": "npm ci" },
    { "id": "npm-install-pkg", "group": "npm", "intent": "outside", "command": "npm install --save-dev vitest" },
    { "id": "npm-test", "group": "npm", "intent": "outside", "command": "npm test" },
    { "id": "npm-run-build", "group": "npm", "intent": "outside", "command": "npm run build" },
    { "id": "npm-run-lint", "group": "npm", "intent": "outside", "command": "npm run lint" },
    { "id": "npm-run-format", "group": "npm", "intent": "source", "command": "npm run format" },
    { "id": "npx-tsc", "group": "npm", "intent": "read", "command": "npx tsc --noEmit" },
    { "id": "npx-eslint", "group": "npm", "intent": "read", "command": "npx eslint src" },
    { "id": "npx-eslint-fix", "group": "npm", "intent": "source", "command": "npx eslint --fix src" },
    { "id": "npx-prettier-write", "group": "npm", "intent": "source", "command": "npx prettier --write src" },
    { "id": "npx-vitest", "group": "npm", "intent": "outside", "command": "npx vitest run" },
    { "id": "pnpm-install", "group": "npm", "intent": "outside", "command": "pnpm install --frozen-lockfile" },
    { "id": "pnpm-test", "group": "npm", "intent": "outside", "command": "pnpm test" },
    { "id": "yarn-build", "group": "npm", "intent": "outside", "command": "yarn build" },
    { "id": "node-script", "group": "npm", "intent": "read", "command": "node scripts/report.mjs" },
    { "id": "node-version", "group": "npm", "intent": "read", "command": "node --version" },
    { "id": "node-print", "group": "npm", "intent": "read", "command": "node -p \"require('./package.json').version\"" },
    { "id": "bun-install", "group": "bun", "intent": "outside", "command": "bun install" },
    { "id": "bun-test", "group": "bun", "intent": "outside", "command": "bun test" },
    { "id": "bun-test-file", "group": "bun", "intent": "outside", "command": "bun test test/a.test.ts" },
    { "id": "bun-test-names-contract", "group": "bun", "intent": "outside", "command": "bun test test/contract.test.ts" },
    { "id": "bun-test-piped", "group": "bun", "intent": "outside", "command": "bun test 2>&1 | tail -5" },
    { "id": "bun-run-typecheck", "group": "bun", "intent": "read", "command": "bun run typecheck" },
    { "id": "bun-script", "group": "bun", "intent": "read", "command": "bun scripts/report.ts --check" },
    { "id": "bun-script-names-command", "group": "bun", "intent": "read", "command": "bun scripts/docs.ts --check" },
    { "id": "bun-script-variable", "group": "bun", "intent": "read", "command": "S=scripts; bun $S/report.ts --check" },
    { "id": "bun-x-tsc", "group": "bun", "intent": "read", "command": "bunx tsc --noEmit" },
    { "id": "bun-chain", "group": "bun", "intent": "outside", "command": "bun run typecheck && bun test" },
    { "id": "make-default", "group": "make", "intent": "outside", "command": "make" },
    { "id": "make-test", "group": "make", "intent": "outside", "command": "make test" },
    { "id": "make-build", "group": "make", "intent": "outside", "command": "make build" },
    { "id": "make-dry", "group": "make", "intent": "read", "command": "make -n test" },
    { "id": "make-jobs", "group": "make", "intent": "outside", "command": "make -j4 build" },
    { "id": "python-version", "group": "python", "intent": "read", "command": "python3 --version" },
    { "id": "python-script", "group": "python", "intent": "read", "command": "python3 scripts/count.py" },
    { "id": "python-print", "group": "python", "intent": "read", "command": "python3 -c \"print(1 + 1)\"" },
    { "id": "python-json-filter", "group": "python", "intent": "read", "command": "cat package.json | python3 -c \"import json,sys; print(json.load(sys.stdin)['name'])\"" },
    { "id": "python-read-file", "group": "python", "intent": "read", "command": "python3 -c \"print(open('package.json').read()[:40])\"" },
    { "id": "python-pytest", "group": "python", "intent": "outside", "command": "python3 -m pytest -q" },
    { "id": "python-pip", "group": "python", "intent": "outside", "command": "python3 -m pip install -r requirements.txt" },
    { "id": "python-write-source", "group": "python", "intent": "source", "command": "python3 -c \"open('src/a.ts','w').write('x')\"" },
    { "id": "python-heredoc-write-tmp", "group": "python", "intent": "outside", "command": "python3 - <<'EOF'\nopen('/tmp/pregate-friction-note.txt','w').write('x')\nEOF" },
    { "id": "ruff-check", "group": "python", "intent": "read", "command": "ruff check ." },
    { "id": "uv-run", "group": "python", "intent": "outside", "command": "uv run pytest -q" },
    { "id": "ls", "group": "shell", "intent": "read", "command": "ls -la src" },
    { "id": "cat", "group": "shell", "intent": "read", "command": "cat src/a.ts" },
    { "id": "head-pipe", "group": "shell", "intent": "read", "command": "cat src/a.ts | head -20" },
    { "id": "grep", "group": "shell", "intent": "read", "command": "grep -rn total src" },
    { "id": "rg", "group": "shell", "intent": "read", "command": "rg -n total src test" },
    { "id": "find", "group": "shell", "intent": "read", "command": "find src -name '*.ts' -newer package.json" },
    { "id": "wc", "group": "shell", "intent": "read", "command": "wc -l src/*.ts" },
    { "id": "sed-print", "group": "shell", "intent": "read", "command": "sed -n 1,20p src/a.ts" },
    { "id": "jq", "group": "shell", "intent": "read", "command": "jq .scripts package.json" },
    { "id": "grep-variable-path", "group": "shell", "intent": "read", "command": "L=/tmp/pregate-friction.log; grep -c fail $L | head -1" },
    { "id": "loop-read", "group": "shell", "intent": "read", "command": "for f in src/*.ts; do wc -l \"$f\"; done" },
    { "id": "mkdir-tmp", "group": "shell", "intent": "outside", "command": "mkdir -p /tmp/pregate-friction-out" },
    { "id": "redirect-tmp", "group": "shell", "intent": "outside", "command": "bun test > /tmp/pregate-friction.log 2>&1" },
    { "id": "tee-tmp", "group": "shell", "intent": "outside", "command": "npm test | tee /tmp/pregate-friction.log" },
    { "id": "curl-read", "group": "shell", "intent": "read", "command": "curl -s https://example.com/health" },
    { "id": "curl-download-tmp", "group": "shell", "intent": "outside", "command": "curl -sL https://example.com/a.tgz -o /tmp/pregate-friction.tgz" },
    { "id": "rm-build", "group": "shell", "intent": "outside", "command": "rm -rf dist" },
    { "id": "cp-doc", "group": "shell", "intent": "outside", "command": "cp README.md /tmp/pregate-friction-readme.md" },
    { "id": "docker-build", "group": "shell", "intent": "outside", "command": "docker build -t app ." },
    { "id": "env-prefix", "group": "shell", "intent": "outside", "command": "NODE_ENV=test npm test" },
    { "id": "cd-and-run", "group": "shell", "intent": "outside", "command": "cd src && ls" },
    { "id": "cd-absolute", "group": "shell", "intent": "read", "command": "cd /tmp && ls" },
    { "id": "type-builtin", "group": "shell", "intent": "read", "command": "type node" },
    { "id": "command-v", "group": "shell", "intent": "read", "command": "command -v node" },
    { "id": "wait-builtin", "group": "shell", "intent": "outside", "command": "npm test & wait" },
    { "id": "redirect-source", "group": "shell", "intent": "source", "command": "echo 'export const a = 1;' > src/a.ts" },
    { "id": "sed-in-place", "group": "shell", "intent": "source", "command": "sed -i '' 's/total/sum/' src/a.ts" },
    { "id": "mv-source", "group": "shell", "intent": "source", "command": "mv src/a.ts src/b.ts" },
    { "id": "rm-source", "group": "shell", "intent": "source", "command": "rm src/a.ts" },
    { "id": "script-file", "group": "shell", "intent": "outside", "command": "./scripts/build.sh" },
    { "id": "bash-script-file", "group": "shell", "intent": "outside", "command": "bash scripts/build.sh" },
    { "id": "bash-script-variable", "group": "shell", "intent": "outside", "command": "SCRIPT=scripts/build.sh; bash \"$SCRIPT\"" },
    { "id": "pregate-status", "group": "pregate", "intent": "read", "command": "pregate status" },
    { "id": "pregate-check", "group": "pregate", "intent": "read", "command": "pregate check --all" },
    { "id": "pregate-audit", "group": "pregate", "intent": "read", "command": "pregate audit" },
    { "id": "pregate-check-stdin", "group": "pregate", "intent": "read", "command": "pregate check --stdin --path src/a.ts < src/a.ts" },
    { "id": "pregate-report", "group": "pregate", "intent": "read", "command": "pregate report" },
    { "id": "pregate-layers", "group": "pregate", "intent": "read", "command": "pregate layers --json" },
    { "id": "pregate-layers-apply", "group": "pregate", "intent": "outside", "command": "pregate layers apply /tmp/pregate-friction-map.json --preview" },
    { "id": "pregate-compile", "group": "pregate", "intent": "read", "command": "pregate compile AGENTS.md --json" },
    { "id": "pregate-compile-apply", "group": "pregate", "intent": "outside", "command": "pregate compile apply /tmp/pregate-friction-proposals.json --preview" },
    { "id": "pregate-rules-test", "group": "pregate", "intent": "read", "command": "pregate rules test" },
    { "id": "pregate-preview", "group": "pregate", "intent": "outside", "command": "pregate guide --preview" },
    { "id": "pregate-cat-contract", "group": "pregate", "intent": "read", "command": "cat .pregate/preset.json" },
    { "id": "pregate-grep-contract", "group": "pregate", "intent": "read", "command": "grep -n engine .pregate/preset.json" },
