import { WsAdapter } from "@nestjs/platform-ws";
import { Transport } from "@nestjs/microservices";
export function bind(app: object) {
  app.useWebSocketAdapter(new WsAdapter(app, { maxPayload: Number(process.env.UNSET) }));
  app.connectMicroservice({ transport: Transport.TCP, options: { maxConcurrentMessages: Number(process.env.UNSET) } });
}
