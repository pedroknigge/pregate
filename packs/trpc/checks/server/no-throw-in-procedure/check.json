{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "trpc/server/no-throw-in-procedure",
  "version": "1.0.1",
  "area": "server",
  "cardinality": "singleton",
  "dimension": "trpc.procedure-error",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "untyped-throw",
          "rule": {
            "kind": "throw_statement",
            "all": [
              {
                "any": [
                  {
                    "regex": "^throw\\s+new\\s+Error\\s*\\("
                  },
                  {
                    "regex": "^throw\\s+new\\s+AggregateError"
                  }
                ]
              },
              {
                "any": [
                  {
                    "inside": {
                      "stopBy": "end",
                      "kind": "program",
                      "regex": "(?i)(\\bfrom\\s*|\\brequire\\s*\\(\\s*|\\bimport\\s*\\(\\s*)[\"'][^\"'\\n]*trpc[^\"'\\n]*[\"']"
                    }
                  },
                  {
                    "inside": {
                      "stopBy": "end",
                      "kind": "call_expression",
                      "has": {
                        "field": "function",
                        "kind": "member_expression",
                        "all": [
                          {
                            "has": {
                              "field": "property",
                              "regex": "^(query|mutation|subscription)$"
                            }
                          },
                          {
                            "has": {
                              "field": "object",
                              "regex": "[Pp]rocedure"
                            }
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} throws an untyped error inside a procedure. Throw new TRPCError with a code so the client receives a failure it can match on."
  }
}
