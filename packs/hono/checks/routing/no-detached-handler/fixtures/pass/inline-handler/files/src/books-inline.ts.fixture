import { Hono } from "hono";

const app = new Hono();

app.get("/books/:id", (c) => {
  const id = c.req.param("id");
  return c.json(`get ${id}`);
});

app.get("/secure", auth, (c) => c.json("ok"));
app.on("GET", "/books", (c) => c.json("list books"));
cache.get("/session", fallback);
headers.get("x-request-id");
