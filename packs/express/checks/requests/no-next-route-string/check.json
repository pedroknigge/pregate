{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "express/requests/no-next-route-string",
  "version": "1.0.1",
  "area": "requests",
  "cardinality": "singleton",
  "dimension": "express.next-route-string",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "next-string-skip",
          "rule": {
            "kind": "call_expression",
            "all": [
              {
                "has": {
                  "field": "function",
                  "regex": "^next$"
                }
              },
              {
                "has": {
                  "field": "arguments",
                  "regex": "^\\(\\s*[\"']router?[\"']"
                }
              }
            ]
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} skips the route stack with next(\"route\") or next(\"router\"). Call next() or pass an error so the flow stays explicit."
  }
}
