{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "node/process/crash-handler-exits",
  "version": "1.0.0",
  "area": "process",
  "cardinality": "singleton",
  "dimension": "node.crash-handler-exits",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "crash-handler-exits",
          "rule": {
            "kind": "call_expression",
            "all": [
              {
                "has": {
                  "field": "function",
                  "regex": "\\.(on|once|addListener)$"
                }
              },
              {
                "has": {
                  "field": "arguments",
                  "has": {
                    "kind": "string",
                    "regex": "^[\"'](uncaughtException|unhandledRejection)[\"']$"
                  }
                }
              },
              {
                "not": {
                  "has": {
                    "stopBy": "end",
                    "any": [
                      {
                        "kind": "call_expression",
                        "regex": "process\\.exit\\s*\\("
                      },
                      {
                        "kind": "throw_statement"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} handles uncaughtException or unhandledRejection without process.exit or rethrow. Exit or rethrow so the process does not resume."
  }
}
