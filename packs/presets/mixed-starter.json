{
  "name": "mixed-starter",
  "version": "1.0.0",
  "engine": "0.0.8",
  "sources": [
    {
      "ns": "core",
      "kind": "builtin",
      "version": "0.0.1"
    },
    {
      "ns": "python",
      "kind": "library",
      "version": "1.4.0"
    },
    {
      "ns": "go",
      "kind": "library",
      "version": "1.2.0"
    },
    {
      "ns": "rust",
      "kind": "library",
      "version": "1.2.0"
    },
    {
      "ns": "clean-code",
      "kind": "library",
      "version": "1.2.0"
    },
    {
      "ns": "typescript",
      "kind": "library",
      "version": "1.3.0"
    }
  ],
  "methodologies": [
    "clean-code/clean-code",
    "python/quality",
    "go/quality",
    "rust/quality",
    "typescript/anti-evasion"
  ],
  "enforcement": "shadow",
  "scope": {
    "include": [
      "**"
    ],
    "exclude": [
      "vendor/**",
      "dist/**",
      "build/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
      "node_modules/**",
      "target/**",
      "**/target/**"
    ]
  },
  "ratchet": {
    "mode": "no-new"
  }
}
