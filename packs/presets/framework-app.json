{
  "$schema": "../../schema/preset.v1.json",
  "name": "framework-app",
  "version": "1.0.0",
  "engine": "0.0.5",
  "sources": [
    {
      "ns": "core",
      "kind": "builtin",
      "version": "0.0.1"
    },
    {
      "ns": "typescript",
      "kind": "path",
      "path": "packs/typescript"
    }
  ],
  "methodologies": [
    "core/pregate-integrity",
    "typescript/strict-types",
    "typescript/named-exports",
    "typescript/framework-entries",
    "typescript/anti-evasion"
  ],
  "enforcement": "enforce",
  "overrides": {
    "typescript/TS-DEFAULT-001": {
      "severity": "deny",
      "params": {
        "exclude": [
          "**/pages/**",
          "**/app/**/page.ts",
          "**/app/**/page.tsx",
          "**/app/**/layout.ts",
          "**/app/**/layout.tsx"
        ]
      },
      "note": "Entry files must default-export. Named exports stay deny everywhere else. Do not resolve modules.default-export to one alias."
    }
  },
  "ratchet": {
    "mode": "no-new"
  }
}
