{
  "$schema": "../../schema/preset.v1.json",
  "name": "vue-spa",
  "version": "1.0.0",
  "engine": "0.0.9",
  "sources": [
    {
      "ns": "core",
      "kind": "builtin",
      "version": "0.0.1"
    },
    {
      "ns": "typescript",
      "kind": "path",
      "path": "packs/typescript"
    },
    {
      "ns": "vue",
      "kind": "path",
      "path": "packs/vue"
    },
    {
      "ns": "tailwind",
      "kind": "path",
      "path": "packs/tailwind"
    }
  ],
  "methodologies": [
    "core/pregate-integrity",
    "typescript/strict-types",
    "typescript/discipline",
    "typescript/named-exports",
    "vue/sfc",
    "vue/reactivity",
    "tailwind/classes",
    "typescript/anti-evasion"
  ],
  "enforcement": "shadow",
  "ratchet": {
    "mode": "no-new"
  }
}
