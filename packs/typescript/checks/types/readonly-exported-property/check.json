{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "typescript/types/readonly-exported-property",
  "version": "1.1.0",
  "area": "types",
  "cardinality": "singleton",
  "dimension": "types.readonly-export",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "mutable-export-field",
          "rule": {
            "kind": "property_signature",
            "not": {
              "any": [
                {
                  "regex": "^\\s*readonly\\b"
                },
                {
                  "inside": {
                    "stopBy": "end",
                    "kind": "interface_declaration",
                    "has": {
                      "field": "name",
                      "kind": "type_identifier",
                      "regex": "^(?:[A-Z][A-Za-z0-9]*)?(?:Options|Config|Configuration|Input)(?:[A-Z][A-Za-z0-9]*)?$"
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": "end",
                    "kind": "type_alias_declaration",
                    "has": {
                      "field": "name",
                      "kind": "type_identifier",
                      "regex": "^(?:[A-Z][A-Za-z0-9]*)?(?:Options|Config|Configuration|Input)(?:[A-Z][A-Za-z0-9]*)?$"
                    }
                  }
                }
              ]
            },
            "inside": {
              "stopBy": {
                "any": [
                  { "kind": "statement_block" },
                  { "kind": "as_expression" },
                  { "kind": "satisfies_expression" },
                  { "kind": "call_expression" },
                  { "kind": "new_expression" },
                  {
                    "all": [
                      { "has": { "kind": "type_arguments" } },
                      { "not": { "kind": "generic_type" } }
                    ]
                  }
                ]
              },
              "kind": "export_statement"
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} exports a mutable property. Mark the public field readonly."
  }
}
