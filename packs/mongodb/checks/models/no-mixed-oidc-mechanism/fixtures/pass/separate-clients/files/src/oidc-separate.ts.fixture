import { MongoClient } from "mongodb";

const callback = async () => ({ accessToken: "token" });
const machine = "mongodb://example.com/?authMechanism=MONGODB-OIDC&authMechanismProperties=ENVIRONMENT:azure,TOKEN_RESOURCE:api://x";

export function machineClient(): MongoClient {
  return new MongoClient(machine, {
    authMechanismProperties: { ENVIRONMENT: "azure", TOKEN_RESOURCE: "api://x" },
  });
}

export function humanClient(uri: string): MongoClient {
  return new MongoClient(uri, {
    authMechanismProperties: { OIDC_CALLBACK: callback },
  });
}
