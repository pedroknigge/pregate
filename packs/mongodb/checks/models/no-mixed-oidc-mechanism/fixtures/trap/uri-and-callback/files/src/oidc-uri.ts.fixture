import { MongoClient } from "mongodb";

const callback = async () => ({ accessToken: "token" });

export function connect(): MongoClient {
  return new MongoClient(
    `mongodb://example.com/?authMechanism=MONGODB-OIDC&authMechanismProperties=ENVIRONMENT:azure,TOKEN_RESOURCE:api://x`,
    {
      authMechanismProperties: {
        OIDC_HUMAN_CALLBACK: callback,
      },
    },
  );
}
