{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "mongodb/models/no-connect-without-options",
  "version": "1.0.1",
  "area": "models",
  "cardinality": "singleton",
  "dimension": "mongodb.models.connect-options",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "connect-options",
          "rule": {
            "kind": "call_expression",
            "all": [
              {
                "has": {
                  "field": "function",
                  "kind": "member_expression",
                  "has": {
                    "field": "property",
                    "regex": "^connect$"
                  }
                }
              },
              {
                "not": {
                  "has": {
                    "field": "arguments",
                    "regex": "(serverSelectionTimeoutMS|maxPoolSize)"
                  }
                }
              },
              {
                "inside": {
                  "stopBy": "end",
                  "kind": "program",
                  "regex": "(\\bfrom\\s*|\\brequire\\s*\\(\\s*|\\bimport\\s*\\(\\s*)[\"'](mongoose|mongodb)(/[^\"'\\n]*)?[\"']"
                }
              }
            ]
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} connects without pool/timeout options. Set maxPoolSize and serverSelectionTimeoutMS."
  }
}
