{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "nextjs/routing/no-next-document-in-app",
  "version": "1.0.1",
  "area": "routing",
  "cardinality": "singleton",
  "dimension": "nextjs.no-next-document-in-app",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "next-document-in-app",
          "files": ["app/**/*", "src/app/**/*"],
          "rule": {
            "kind": "string_fragment",
            "regex": "next/document",
            "inside": {
              "kind": "string",
              "any": [
                {
                  "inside": {
                    "field": "source",
                    "any": [
                      { "kind": "import_statement" },
                      { "kind": "export_statement" }
                    ]
                  }
                },
                {
                  "nthChild": {
                    "position": 1,
                    "ofRule": { "not": { "kind": "comment" } }
                  },
                  "inside": {
                    "kind": "arguments",
                    "inside": {
                      "kind": "call_expression",
                      "has": {
                        "field": "function",
                        "any": [
                          { "kind": "import" },
                          { "kind": "identifier", "regex": "^require$" }
                        ]
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  },
  "phase": ["pre", "stop", "commit", "ci"],
  "feedback": {
    "message": "{symbol} imports from next/document in the App Router. Declare document metadata in the route segment instead."
  }
}
