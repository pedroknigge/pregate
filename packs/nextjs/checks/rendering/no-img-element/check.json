{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "nextjs/rendering/no-img-element",
  "version": "1.0.1",
  "area": "rendering",
  "cardinality": "singleton",
  "dimension": "nextjs.no-img-element",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "img-element",
          "rule": {
            "regex": "^<img\\b",
            "has": {
              "field": "name",
              "kind": "identifier",
              "regex": "^img$"
            }
          }
        }
      ]
    }
  },
  "phase": ["pre", "stop", "commit", "ci"],
  "feedback": {
    "message": "{symbol} renders a raw img element. Use the next/image component instead."
  }
}
