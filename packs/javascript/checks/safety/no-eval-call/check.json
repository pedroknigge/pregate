{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "javascript/safety/no-eval-call",
  "version": "1.0.2",
  "area": "safety",
  "cardinality": "singleton",
  "dimension": "javascript.eval-call",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "eval-call",
          "rule": {
            "any": [
              {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "matches": "eval-callee"
                }
              },
              {
                "kind": "new_expression",
                "has": {
                  "field": "constructor",
                  "regex": "^Function$"
                }
              }
            ]
          },
          "utils": {
            "eval-atom": {
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^eval$"
                },
                {
                  "kind": "member_expression",
                  "regex": "\\.eval$"
                },
                {
                  "matches": "eval-bracket"
                }
              ]
            },
            "eval-host": {
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^(?:window|globalThis|self|global)$"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "eval-host"
                  }
                }
              ]
            },
            "eval-bracket": {
              "kind": "subscript_expression",
              "all": [
                {
                  "has": {
                    "field": "object",
                    "matches": "eval-host"
                  }
                },
                {
                  "has": {
                    "field": "index",
                    "kind": "string",
                    "regex": "^[\"']eval[\"']$"
                  }
                }
              ]
            },
            "direct-eval": {
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^eval$"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "direct-eval"
                  }
                }
              ]
            },
            "eval-declarator": {
              "kind": "variable_declarator",
              "all": [
                {
                  "has": {
                    "field": "name",
                    "kind": "identifier",
                    "pattern": "$NAME"
                  }
                },
                {
                  "has": {
                    "field": "value",
                    "matches": "direct-eval"
                  }
                }
              ]
            },
            "eval-decl-statement": {
              "any": [
                {
                  "kind": "lexical_declaration",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "eval-declarator"
                  }
                },
                {
                  "kind": "variable_declaration",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "eval-declarator"
                  }
                },
                {
                  "kind": "export_statement",
                  "has": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "lexical_declaration",
                        "has": {
                          "stopBy": "neighbor",
                          "matches": "eval-declarator"
                        }
                      },
                      {
                        "kind": "variable_declaration",
                        "has": {
                          "stopBy": "neighbor",
                          "matches": "eval-declarator"
                        }
                      }
                    ]
                  }
                },
                {
                  "kind": "expression_statement",
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "assignment_expression",
                    "all": [
                      {
                        "has": {
                          "field": "left",
                          "kind": "identifier",
                          "pattern": "$NAME"
                        }
                      },
                      {
                        "has": {
                          "field": "right",
                          "matches": "direct-eval"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            "eval-default-param": {
              "any": [
                {
                  "kind": "required_parameter"
                },
                {
                  "kind": "optional_parameter"
                }
              ],
              "all": [
                {
                  "has": {
                    "field": "pattern",
                    "kind": "identifier",
                    "pattern": "$NAME"
                  }
                },
                {
                  "has": {
                    "field": "value",
                    "matches": "direct-eval"
                  }
                }
              ]
            },
            "eval-rebind": {
              "any": [
                {
                  "kind": "variable_declarator",
                  "all": [
                    {
                      "has": {
                        "field": "name",
                        "kind": "identifier",
                        "pattern": "$NAME"
                      }
                    },
                    {
                      "not": {
                        "has": {
                          "field": "value",
                          "matches": "direct-eval"
                        }
                      }
                    }
                  ]
                },
                {
                  "kind": "required_parameter",
                  "all": [
                    {
                      "has": {
                        "field": "pattern",
                        "kind": "identifier",
                        "pattern": "$NAME"
                      }
                    },
                    {
                      "not": {
                        "has": {
                          "field": "value",
                          "matches": "direct-eval"
                        }
                      }
                    }
                  ]
                },
                {
                  "kind": "optional_parameter",
                  "has": {
                    "field": "pattern",
                    "kind": "identifier",
                    "pattern": "$NAME"
                  }
                },
                {
                  "kind": "required_parameter",
                  "has": {
                    "field": "pattern",
                    "kind": "rest_pattern",
                    "has": {
                      "kind": "identifier",
                      "pattern": "$NAME"
                    }
                  }
                },
                {
                  "kind": "function_declaration",
                  "has": {
                    "field": "name",
                    "kind": "identifier",
                    "pattern": "$NAME"
                  }
                },
                {
                  "kind": "class_declaration",
                  "has": {
                    "field": "name",
                    "pattern": "$NAME"
                  }
                },
                {
                  "kind": "for_in_statement",
                  "has": {
                    "field": "left",
                    "kind": "identifier",
                    "pattern": "$NAME"
                  }
                },
                {
                  "kind": "catch_clause",
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "identifier",
                    "pattern": "$NAME"
                  }
                }
              ]
            },
            "alias-callee": {
              "all": [
                {
                  "kind": "identifier"
                },
                {
                  "pattern": "$NAME"
                },
                {
                  "not": {
                    "regex": "^eval$"
                  }
                },
                {
                  "inside": {
                    "stopBy": "end",
                    "any": [
                      {
                        "all": [
                          {
                            "follows": {
                              "stopBy": "end",
                              "matches": "eval-decl-statement"
                            }
                          },
                          {
                            "not": {
                              "matches": "eval-rebind"
                            }
                          },
                          {
                            "not": {
                              "has": {
                                "stopBy": "end",
                                "matches": "eval-rebind"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "all": [
                          {
                            "has": {
                              "field": "parameters",
                              "stopBy": "end",
                              "matches": "eval-default-param"
                            }
                          },
                          {
                            "not": {
                              "has": {
                                "field": "body",
                                "stopBy": "end",
                                "matches": "eval-rebind"
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            },
            "eval-callee": {
              "any": [
                {
                  "matches": "eval-atom"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "eval-callee"
                  }
                },
                {
                  "matches": "eval-comma"
                },
                {
                  "matches": "alias-callee"
                }
              ]
            },
            "eval-comma": {
              "kind": "sequence_expression",
              "has": {
                "matches": "eval-callee",
                "nthChild": {
                  "position": 1,
                  "reverse": true
                }
              }
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} evaluates a string as code. Parse the value or call the function directly."
  }
}
