export function browser(code: string) {
  return window["eval"](code);
}

export function realm(code: string) {
  return globalThis["eval"](code);
}

export function frame(code: string) {
  return self["eval"](code);
}

export function host(code: string) {
  return global["eval"](code);
}

export function quoted(code: string) {
  return window['eval'](code);
}
