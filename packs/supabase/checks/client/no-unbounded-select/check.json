{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "supabase/client/no-unbounded-select",
  "version": "1.0.1",
  "area": "client",
  "cardinality": "singleton",
  "dimension": "supabase.unbounded-select",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "unbounded-select",
          "utils": {
            "supabase-import": {
              "kind": "string_fragment",
              "regex": "^@supabase/(supabase-js|ssr)(/|$)",
              "inside": {
                "kind": "string",
                "any": [
                  {
                    "inside": {
                      "field": "source",
                      "any": [
                        { "kind": "import_statement" },
                        { "kind": "export_statement" }
                      ]
                    }
                  },
                  {
                    "nthChild": {
                      "position": 1,
                      "ofRule": { "not": { "kind": "comment" } }
                    },
                    "inside": {
                      "kind": "arguments",
                      "inside": {
                        "kind": "call_expression",
                        "has": {
                          "field": "function",
                          "any": [
                            { "kind": "import" },
                            { "kind": "identifier", "regex": "^require$" }
                          ]
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          "rule": {
            "any": [
              { "kind": "expression_statement" },
              { "kind": "variable_declarator" }
            ],
            "regex": "\\.from\\s*\\([\\s\\S]*\\.select\\s*\\(",
            "not": {
              "any": [
                { "regex": "\\.(range|limit|order|maybeSingle|single)\\s*\\(" },
                { "regex": "\\.(insert|update|upsert|delete)\\s*\\(" }
              ]
            },
            "inside": {
              "stopBy": "end",
              "kind": "program",
              "has": {
                "stopBy": "end",
                "matches": "supabase-import"
              }
            }
          }
        }
      ]
    }
  },
  "phase": ["pre", "stop", "commit", "ci"],
  "feedback": {
    "message": "{symbol} selects rows with no range, limit, order, single, or maybeSingle in the same statement. Add a bound, or return rows from a mutation, so one call cannot read the whole table."
  }
}
