{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "supabase/client/no-auth-admin-in-client",
  "version": "1.0.1",
  "area": "client",
  "cardinality": "singleton",
  "dimension": "supabase.auth-admin-in-client",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "auth-admin-client",
          "rule": {
            "kind": "call_expression",
            "regex": "\\.auth\\.admin\\."
          },
          "files": [
            "app/**",
            "components/**",
            "pages/**",
            "src/app/**",
            "src/components/**",
            "src/pages/**"
          ],
          "ignores": [
            "**/server/**",
            "**/*.server.*",
            "app/api/**",
            "src/app/api/**",
            "pages/api/**",
            "src/pages/api/**",
            "**/route.{js,jsx,ts,tsx}"
          ]
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} calls supabase.auth.admin.* from client-reachable code. The admin API bypasses RLS; keep it server-side and expose safe operations through routes."
  }
}
