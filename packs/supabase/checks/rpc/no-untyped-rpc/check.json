{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "supabase/rpc/no-untyped-rpc",
  "version": "1.1.0",
  "area": "rpc",
  "cardinality": "singleton",
  "dimension": "supabase.untyped-rpc",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "untyped-rpc",
          "utils": {
            "supabase-import": {
              "kind": "string_fragment",
              "regex": "^@supabase/(supabase-js|ssr)(/|$)",
              "inside": {
                "kind": "string",
                "any": [
                  {
                    "inside": {
                      "field": "source",
                      "any": [
                        { "kind": "import_statement" },
                        { "kind": "export_statement" }
                      ]
                    }
                  },
                  {
                    "nthChild": {
                      "position": 1,
                      "ofRule": { "not": { "kind": "comment" } }
                    },
                    "inside": {
                      "kind": "arguments",
                      "inside": {
                        "kind": "call_expression",
                        "has": {
                          "field": "function",
                          "any": [
                            { "kind": "import" },
                            { "kind": "identifier", "regex": "^require$" }
                          ]
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          "rule": {
            "kind": "call_expression",
            "regex": "\\.rpc\\s*\\(",
            "not": {
              "regex": "\\.rpc\\s*\\(\\s*([\"'][^\"']*[\"']|`[^`$]*`)\\s*[,)]"
            },
            "inside": {
              "stopBy": "end",
              "kind": "program",
              "has": {
                "stopBy": "end",
                "matches": "supabase-import"
              }
            }
          }
        }
      ]
    }
  },
  "phase": ["pre", "stop", "commit", "ci"],
  "feedback": {
    "message": "{symbol} calls rpc with a computed function name. Pass the static name from the generated Database types so the call is checked."
  }
}
