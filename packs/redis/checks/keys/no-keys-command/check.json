{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "redis/keys/no-keys-command",
  "version": "1.0.1",
  "area": "keys",
  "cardinality": "singleton",
  "dimension": "redis.scan-instead-of-keys",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "keys-call",
          "rule": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "kind": "member_expression",
              "all": [
                {
                  "has": {
                    "field": "property",
                    "regex": "^keys$"
                  }
                },
                {
                  "any": [
                    {
                      "has": {
                        "field": "object",
                        "regex": "(?i)^[\\w$.()]*(redis|valkey)[\\w$.()]*$"
                      }
                    },
                    {
                      "all": [
                        {
                          "has": {
                            "field": "object",
                            "regex": "^(this\\.)?(client|cache|db|kv|store|pub|sub|publisher|subscriber)$"
                          }
                        },
                        {
                          "inside": {
                            "stopBy": "end",
                            "kind": "program",
                            "regex": "(?i)(\\bfrom\\s*|\\brequire\\s*\\(\\s*|\\bimport\\s*\\(\\s*)[\"'][^\"'\\n]*(redis|valkey|@vercel/kv)[^\"'\\n]*[\"']"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} calls KEYS, which blocks the server. Iterate with SCAN instead."
  }
}
