{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "redis/keys/no-unprefixed-key",
  "version": "1.0.1",
  "area": "keys",
  "cardinality": "singleton",
  "dimension": "redis.key-namespace",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "bare-key",
          "utils": {
            "redis-receiver": {
              "any": [
                {
                  "has": {
                    "field": "object",
                    "regex": "(?i)^[\\w$.()]*(redis|valkey)[\\w$.()]*$"
                  }
                },
                {
                  "all": [
                    {
                      "has": {
                        "field": "object",
                        "regex": "^(this\\.)?(client|cache|db|kv|store|pub|sub|publisher|subscriber)$"
                      }
                    },
                    {
                      "inside": {
                        "stopBy": "end",
                        "kind": "program",
                        "regex": "(?i)(\\bfrom\\s*|\\brequire\\s*\\(\\s*|\\bimport\\s*\\(\\s*)[\"'][^\"'\\n]*(redis|valkey|@vercel/kv)[^\"'\\n]*[\"']"
                      }
                    }
                  ]
                }
              ]
            }
          },
          "rule": {
            "kind": "call_expression",
            "all": [
              {
                "has": {
                  "field": "function",
                  "kind": "member_expression",
                  "all": [
                    {
                      "has": {
                        "field": "property",
                        "regex": "^(set|get|del|expire|exists)$"
                      }
                    },
                    {
                      "matches": "redis-receiver"
                    }
                  ]
                }
              },
              {
                "has": {
                  "field": "arguments",
                  "regex": "^\\(\\s*[\"'][^\"':]+[\"']"
                }
              }
            ]
          }
        },
        {
          "id": "bare-template-key",
          "utils": {
            "redis-receiver": {
              "any": [
                {
                  "has": {
                    "field": "object",
                    "regex": "(?i)^[\\w$.()]*(redis|valkey)[\\w$.()]*$"
                  }
                },
                {
                  "all": [
                    {
                      "has": {
                        "field": "object",
                        "regex": "^(this\\.)?(client|cache|db|kv|store|pub|sub|publisher|subscriber)$"
                      }
                    },
                    {
                      "inside": {
                        "stopBy": "end",
                        "kind": "program",
                        "regex": "(?i)(\\bfrom\\s*|\\brequire\\s*\\(\\s*|\\bimport\\s*\\(\\s*)[\"'][^\"'\\n]*(redis|valkey|@vercel/kv)[^\"'\\n]*[\"']"
                      }
                    }
                  ]
                }
              ]
            }
          },
          "rule": {
            "kind": "call_expression",
            "all": [
              {
                "has": {
                  "field": "function",
                  "kind": "member_expression",
                  "all": [
                    {
                      "has": {
                        "field": "property",
                        "regex": "^(set|get|del|expire|exists)$"
                      }
                    },
                    {
                      "matches": "redis-receiver"
                    }
                  ]
                }
              },
              {
                "has": {
                  "field": "arguments",
                  "regex": "^\\(\\s*`[^`$:]+`"
                }
              }
            ]
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} uses a key with no namespace prefix. Name keys as <domain>:<id>."
  }
}
